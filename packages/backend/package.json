{
  "name": "@logiclike/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --project tsconfig.json --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "kill": "lsof -ti:3000 | xargs kill -9 2>/dev/null; echo 'Port 3000 freed'"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@logiclike/shared": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^22.0.0"
  }
}